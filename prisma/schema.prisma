generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                  String    @id @default(cuid())
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now())
  user_id             String
  type                String?
  provider            String?
  provider_account_id String?
  refresh_token       String?
  access_token        String?
  expires_at          DateTime?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@map("accounts")
}

model User {
  id                    String               @id @default(cuid())
  created_at            DateTime             @default(now())
  updated_at            DateTime             @default(now())
  deleted_at            DateTime?
  status                Int?                 @default(1) @db.SmallInt
  first_name            String?              @db.VarChar(255)
  last_name             String?              @db.VarChar(255)
  avatar                String?
  about_me              String?
  email                 String?              @unique
  address               String?
  password              String?              @db.VarChar(255)
  type                  UserType?            @default(CLIENT)
  name                  String?              @db.VarChar(255)
  location              String?              @db.VarChar(255)
  language              String?              @db.VarChar(100)
  billing_id            String?
  stripe_connect_id     String?
  balance               Decimal?             @default(0.0) @db.Decimal(10, 2)
  email_verified_at     DateTime?
  bio                   String?
  domain                String?              @unique
  username              String?              @unique
  phone_number          String?
  country               String?
  state                 String?
  city                  String?
  zip_code              String?
  gender                String?
  date_of_birth         DateTime?            @db.Date
  approved_at           DateTime?
  availability          String?
  is_two_factor_enabled Int?                 @default(0)
  two_factor_secret     String?
  points                Int?                 @default(0)
  device_type           String?
  fcm_token             String?
  wins                  Int?                 @default(0)
  losses                Int?                 @default(0)
  kyc_status            String?              @default("UNVERIFIED")
  kyc_document_type     String?
  kyc_document_url      String?
  kyc_submitted_at      DateTime?
  kyc_verified_at       DateTime?
  kyc_rejection_reason  String?
  sentMessages          Message[]            @relation("messageSender")
  receivedNotifications Notification[]       @relation("notificationReceiver")
  sentNotifications     Notification[]       @relation("notificationSender")
  participants          Participant[]        @relation("participantUser")
  accounts              Account[]
  comments              Comment[]
  feedbacks_given       Feedback[]           @relation("FeedbackAuthor")
  follows_given         UserFollow[]         @relation("following")
  follows_received      UserFollow[]         @relation("followers")
  reviews_given         UserReview[]         @relation("reviews_authored")
  reviews_received      UserReview[]         @relation("reviews_target")
  created_bets          Bet[]                @relation("created_bets")
  bet_comments          BetComment[]         @relation("bet_comments")
  bet_participations    BetParticipant[]     @relation("bet_participants")
  createdDisputes       BetDispute[]         @relation("disputeCreator")
  resolvedDisputes      BetDispute[]         @relation("disputeResolver")
  gamingMatchChecks     GamingMatchCheck[]
  liveStreams           live_streams[]
  payment_transactions  PaymentTransaction[]
  postCommunities       PostCommunity[]
  postLikes             PostLike[]
  created_requests      Request[]            @relation("SeekerRequests")
  accepted_tasks        Request[]            @relation("VolunteerTasks")
  role_users            RoleUser[]
  ucodes                Ucode[]
  user_payment_methods  UserPaymentMethod[]

  @@map("users")
}

model Ucode {
  id          String    @id @default(cuid())
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
  status      Int?      @default(1) @db.SmallInt
  user_id     String?
  token       String?
  email       String?
  expired_at  DateTime?
  verified_at DateTime?
  user        User?     @relation(fields: [user_id], references: [id])

  @@map("ucodes")
}

model PostCommunity {
  id           String     @id @default(uuid())
  author_id    String
  title        String?
  content      String?
  image_url    String?
  location_tag String?
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  comments     Comment[]
  user         User       @relation(fields: [author_id], references: [id])
  likes        PostLike[]

  @@map("post_communities")
}

model Comment {
  id         String        @id @default(uuid())
  post_id    String
  author_id  String
  content    String
  created_at DateTime      @default(now())
  parent_id  String?
  user       User          @relation(fields: [author_id], references: [id])
  parent     Comment?      @relation("CommentReplies", fields: [parent_id], references: [id])
  replies    Comment[]     @relation("CommentReplies")
  post       PostCommunity @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("comments")
}

model PostLike {
  id         String        @id @default(uuid())
  post_id    String
  user_id    String
  created_at DateTime      @default(now())
  post       PostCommunity @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [user_id], references: [id])

  @@unique([post_id, user_id])
  @@map("post_likes")
}

model Request {
  id                 String          @id @default(uuid())
  title              String
  description        String
  category           RequestCategory
  location           String
  estimated_duration String?
  urgency_level      UrgencyLevel    @default(MEDIUM)
  skills_needed      String[]
  status             RequestStatus   @default(PENDING)
  seeker_id          String
  volunteer_id       String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  attachments        Attachment[]    @relation("RequestAttachments")
  feedbacks          Feedback[]
  seeker             User            @relation("SeekerRequests", fields: [seeker_id], references: [id])
  volunteer          User?           @relation("VolunteerTasks", fields: [volunteer_id], references: [id])

  @@map("requests")
}

model Feedback {
  id          String   @id @default(uuid())
  comment     String?
  request_id  String
  user_id     String
  created_at  DateTime @default(now())
  rating_type Boolean?
  request     Request  @relation(fields: [request_id], references: [id])
  user        User     @relation("FeedbackAuthor", fields: [user_id], references: [id])

  @@map("feedbacks")
}

model Conversation {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  participants Participant[]
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           String?      @default("participant")
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation("participantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String        @id @default(cuid())
  text           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  status         MessageStatus @default(PENDING)
  senderId       String
  conversationId String
  attachments    String[]
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("messageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

model NotificationEvent {
  id            String         @id @default(uuid())
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  deleted_at    DateTime?
  status        Int?           @default(1) @db.SmallInt
  type          String?
  text          String?
  notifications Notification[]
}

model Notification {
  id                    String             @id @default(cuid())
  created_at            DateTime           @default(now())
  updated_at            DateTime           @default(now()) @updatedAt
  deleted_at            DateTime?
  read_at               DateTime?
  status                Int?               @default(1) @db.SmallInt
  sender_id             String?
  receiver_id           String?
  notification_event_id String?
  entity_id             String?
  latest_news           Boolean            @default(true)
  sign_of_disaster      Boolean            @default(true)
  message_news          Boolean            @default(true)
  notification_event    NotificationEvent? @relation(fields: [notification_event_id], references: [id])
  receiver              User?              @relation("notificationReceiver", fields: [receiver_id], references: [id])
  sender                User?              @relation("notificationSender", fields: [sender_id], references: [id])
}

model video_calls {
  id          String    @id @default(uuid())
  room_name   String    @unique
  caller_id   String
  receiver_id String
  status      String    @default("pending")
  started_at  DateTime  @default(now())
  ended_at    DateTime?
  duration    Int?

  @@index([caller_id, receiver_id])
}

model live_streams {
  id             String    @id @default(uuid())
  room_name      String    @unique
  host_id        String
  title          String?
  is_active      Boolean   @default(true)
  recording_url  String?   // Auto-record houar por S3 link ekhane thakbe
  status         String    @default("streaming") // streaming, completed, failed
  created_at     DateTime  @default(now())
  ended_at       DateTime?
  
  host           User      @relation(fields: [host_id], references: [id])
}

model Role {
  id               String           @id @default(cuid())
  created_at       DateTime         @default(now())
  updated_at       DateTime         @default(now())
  deleted_at       DateTime?
  status           Int?             @default(1) @db.SmallInt
  title            String?
  name             String?
  permission_roles PermissionRole[]
  role_users       RoleUser[]
  permissions      Permission[]     @relation("PermissionToRole")

  @@map("roles")
}

model Permission {
  id               String           @id @default(cuid())
  created_at       DateTime         @default(now())
  updated_at       DateTime         @default(now())
  deleted_at       DateTime?
  status           Int?             @default(1) @db.SmallInt
  title            String?
  action           String?
  subject          String?
  conditions       String?
  fields           String?
  permission_roles PermissionRole[]
  roles            Role[]           @relation("PermissionToRole")

  @@map("permissions")
}

model PermissionRole {
  created_at    DateTime   @default(now())
  updated_at    DateTime   @default(now())
  permission_id String
  role_id       String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([permission_id, role_id])
  @@map("permission_roles")
}

model RoleUser {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  role_id    String
  user_id    String
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([role_id, user_id])
  @@map("role_users")
}

model UserPaymentMethod {
  id                String    @id @default(cuid())
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())
  deleted_at        DateTime?
  user_id           String?
  payment_method_id String?
  checkout_id       String?
  user              User?     @relation(fields: [user_id], references: [id])

  @@map("user_payment_methods")
}

model PaymentTransaction {
  id               String    @id @default(cuid())
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now())
  deleted_at       DateTime?
  store_id         String?
  user_id          String?
  order_id         String?
  type             String?   @default("order")
  withdraw_via     String?   @default("wallet")
  provider         String?
  reference_number String?
  status           String?   @default("pending")
  raw_status       String?
  amount           Decimal?
  currency         String?
  paid_amount      Decimal?
  paid_currency    String?
  description      String?
  destination_details String?
  proof_url        String?
  network          String?
  user             User?     @relation(fields: [user_id], references: [id])

  @@map("payment_transactions")
}

model Faq {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?
  status     Int?      @default(1) @db.SmallInt
  sort_order Int?      @default(0)
  question   String?
  answer     String?

  @@map("faqs")
}

model Contact {
  id           String    @id @default(cuid())
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now())
  deleted_at   DateTime?
  first_name   String?
  last_name    String?
  email        String?
  phone_number String?
  message      String?

  @@map("contacts")
}

model Attachment {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?
  name       String?
  type       String?
  path       String?
  request_id String
  request    Request   @relation("RequestAttachments", fields: [request_id], references: [id], onDelete: Cascade)

  @@map("attachments")
}

enum UserType {
  ADMIN
  CLIENT
  EDITOR
  MAID
  SEEKER
  VOLUNTEER
}

enum RequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum RequestCategory {
  HURRICANE_PREPARATION
  DURING_STORM
  RECOVERY_CLEANUP
  EMERGENCY_NON_911
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  PENDING
}

model UserFollow {
  id           String   @id @default(cuid())
  follower_id  String
  following_id String
  created_at   DateTime @default(now())

  follower  User @relation("following", fields: [follower_id], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@map("user_follows")
}

model UserReview {
  id         String   @id @default(cuid())
  author_id  String
  user_id    String
  rating     Int      @default(5)
  comment    String?
  created_at DateTime @default(now())

  author User @relation("reviews_authored", fields: [author_id], references: [id], onDelete: Cascade)
  target User @relation("reviews_target", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_reviews")
}

model Bet {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    String       @default("SPORTS")
  creator_id  String
  status      String       @default("ACTIVE")
  bet_type    String       @default("BINARY")
  is_private  Boolean      @default(false)
  is_featured Boolean      @default(false)
  country     String?
  invite_code String?      @unique
  deadline    DateTime?
  total_pool     Decimal          @default(0.0)
  back_pool      Decimal          @default(0.0)
  oppose_pool    Decimal          @default(0.0)
  matched_pool   Decimal          @default(0.0) @db.Decimal(10, 2)
  unmatched_pool Decimal          @default(0.0) @db.Decimal(10, 2)
  winning_side       String?
  winning_outcome_id String?
  resolved_at        DateTime?
  payout_pool        Decimal          @default(0.0) @db.Decimal(10, 2)
  escrow_status      String           @default("LOCKED")
  commission_rate    Decimal          @default(10.0) @db.Decimal(5, 2)
  commission_amount  Decimal          @default(0.0) @db.Decimal(10, 2)
  created_at     DateTime         @default(now())
  updated_at  DateTime     @updatedAt

  creator      User             @relation("created_bets", fields: [creator_id], references: [id], onDelete: Cascade)
  comments     BetComment[]
  participants BetParticipant[]
  outcomes     BetOutcome[]
  disputes     BetDispute[]
  gamingMatchChecks GamingMatchCheck[]
  ai_insight   BetAiInsight?

  @@map("bets")
}

model GamingMatchCheck {
  id               String       @id @default(cuid())
  created_at       DateTime     @default(now())
  updated_at       DateTime     @default(now()) @updatedAt
  bet_id           String
  player_id        String
  platform         String       @default("PLAYSTATION")
  gamertag         String?
  my_score         Int
  opponent_score   Int
  proof_url        String?

  bet              Bet          @relation(fields: [bet_id], references: [id], onDelete: Cascade)
  player           User         @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@unique([bet_id, player_id])
  @@map("gaming_match_checks")
}

model BetDispute {
  id               String       @id @default(cuid())
  created_at       DateTime     @default(now())
  updated_at       DateTime     @default(now()) @updatedAt
  bet_id           String
  creator_id       String
  reason           String
  description      String       @db.Text
  evidence_url     String?
  status           String       @default("OPEN")
  resolution       String?
  resolution_notes String?      @db.Text
  resolver_id      String?
  resolved_at      DateTime?

  bet              Bet          @relation(fields: [bet_id], references: [id], onDelete: Cascade)
  creator          User         @relation("disputeCreator", fields: [creator_id], references: [id], onDelete: Cascade)
  resolver         User?        @relation("disputeResolver", fields: [resolver_id], references: [id])

  @@map("bet_disputes")
}

model BetOutcome {
  id           String           @id @default(cuid())
  bet_id       String
  title        String
  pool         Decimal          @default(0.0) @db.Decimal(10, 2)
  is_winner    Boolean?
  created_at   DateTime         @default(now())

  bet          Bet              @relation(fields: [bet_id], references: [id], onDelete: Cascade)
  participants BetParticipant[]

  @@map("bet_outcomes")
}

model BetComment {
  id         String   @id @default(cuid())
  bet_id     String
  author_id  String
  content    String
  stance     String?  @default("SPECTATOR")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  author     User     @relation("bet_comments", fields: [author_id], references: [id], onDelete: Cascade)
  bet        Bet      @relation(fields: [bet_id], references: [id], onDelete: Cascade)

  @@map("bet_comments")
}

model BetParticipant {
  id         String      @id @default(cuid())
  bet_id     String
  user_id    String
  side       String      @default("BACK")
  outcome_id String?
  stake           Decimal     @default(0.0) @db.Decimal(10, 2)
  matched_stake   Decimal     @default(0.0) @db.Decimal(10, 2)
  unmatched_stake Decimal     @default(0.0) @db.Decimal(10, 2)
  match_status    String      @default("UNMATCHED")
  refunded_amount Decimal     @default(0.0) @db.Decimal(10, 2)
  is_winner       Boolean?
  payout_amount   Decimal     @default(0.0) @db.Decimal(10, 2)
  payout_status   String?     @default("PENDING")
  gross_payout        Decimal     @default(0.0) @db.Decimal(10, 2)
  commission_deducted Decimal     @default(0.0) @db.Decimal(10, 2)
  net_payout          Decimal     @default(0.0) @db.Decimal(10, 2)
  created_at      DateTime    @default(now())

  bet        Bet         @relation(fields: [bet_id], references: [id], onDelete: Cascade)
  outcome    BetOutcome? @relation(fields: [outcome_id], references: [id], onDelete: SetNull)
  user       User        @relation("bet_participants", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([bet_id, user_id, side])
  @@map("bet_participants")
}

model PlatformFeeConfig {
  id                String   @id @default(cuid())
  commission_rate   Decimal  @default(10.0) @db.Decimal(5, 2)
  applies_to_profit Boolean  @default(true)
  description       String?  @default("Default platform commission on net winning profit")
  updated_by        String?
  updated_at        DateTime @updatedAt
  created_at        DateTime @default(now())

  @@map("platform_fee_configs")
}

model BetAiInsight {
  id               String   @id @default(cuid())
  bet_id           String   @unique
  topic            String
  summary          String   @db.Text
  suggested_stance String?  @default("NEUTRAL")
  confidence_score Decimal  @default(0.75) @db.Decimal(4, 2)
  risk_level       String   @default("MODERATE")
  key_factors      Json?
  market_sentiment Json?
  sources          Json?
  updated_at       DateTime @updatedAt
  created_at       DateTime @default(now())

  bet              Bet      @relation(fields: [bet_id], references: [id], onDelete: Cascade)

  @@map("bet_ai_insights")
}
